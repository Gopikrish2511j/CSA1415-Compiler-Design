#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX_IDENT_LEN 31

int isOperator(char ch) {
    char operators[] = "+-*/%=<>!&|";
    for (int i = 0; i < strlen(operators); i++) {
        if (ch == operators[i]) return 1;
    }
    return 0;
}

void analyze(char *input) {
    int i = 0;
    int length = strlen(input);

    printf("\n--- TOKEN ANALYSIS ---\n");

    while (i < length) {
        // 1. Skip Spaces, Tabs, Newlines
        if (input[i] == ' ' || input[i] == '\t' || input[i] == '\n') {
            i++;
            continue;
        }

        // 2a. Skip Single-line Comments (//)
        if (input[i] == '/' && input[i + 1] == '/') {
            i += 2;
            while (i < length && input[i] != '\n') {
                i++;
            }
            continue;
        }

        // 2b. Skip Multi-line Comments (/* ... */)
        if (input[i] == '/' && input[i + 1] == '*') {
            i += 2;
            while (i < length - 1 && !(input[i] == '*' && input[i + 1] == '/')) {
                i++;
            }
            i += 2; // Skip closing */
            continue;
        }

        // 3. Extract Identifiers
        if (isalpha(input[i]) || input[i] == '_') {
            char buffer[MAX_IDENT_LEN + 1];
            int buf_idx = 0;

            while (i < length && (isalnum(input[i]) || input[i] == '_')) {
                if (buf_idx < MAX_IDENT_LEN) {
                    buffer[buf_idx++] = input[i];
                }
                i++;
            }
            buffer[buf_idx] = '\0';
            printf("Identifier : %s\n", buffer);
            continue;
        }

        // 4. Extract Constants
        if (isdigit(input[i])) {
            char buffer[100];
            int buf_idx = 0;

            while (i < length && isdigit(input[i])) {
                buffer[buf_idx++] = input[i];
                i++;
            }
            buffer[buf_idx] = '\0';
            printf("Constant   : %s\n", buffer);
            continue;
        }

        // 5. Extract Operators
        if (isOperator(input[i])) {
            printf("Operator   : %c\n", input[i]);
            i++;
            continue;
        }

        i++; // Skip other delimiters like ';', '(', ')'
    }
}

int main() {
    char inputCode[] = 
        "// Calculate area\n"
        "/* Multi-line \n"
        "   comment */\n"
        "int area = length * 10;";

    printf("Input Code:\n%s\n", inputCode);
    analyze(inputCode);

    return 0;
}
