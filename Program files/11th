#include <stdio.h>
#include <string.h>

#define MAX 100

struct Symbol
{
    char name[50];
    char type[20];
    char value[50];
};

struct Symbol table[MAX];
int count = 0;

int search(char name[])
{
    int i;

    for (i = 0; i < count; i++)
    {
        if (strcmp(table[i].name, name) == 0)
            return i;
    }

    return -1;
}

void insert()
{
    char name[50];

    printf("Enter symbol name: ");
    scanf("%s", name);

    if (search(name) != -1)
    {
        printf("Symbol already exists!\n");
        return;
    }

    strcpy(table[count].name, name);

    printf("Enter symbol type: ");
    scanf("%s", table[count].type);

    printf("Enter symbol value: ");
    scanf("%s", table[count].value);

    count++;

    printf("Symbol inserted successfully.\n");
}

void deleteSymbol()
{
    char name[50];
    int pos, i;

    printf("Enter symbol name to delete: ");
    scanf("%s", name);

    pos = search(name);

    if (pos == -1)
    {
        printf("Symbol not found!\n");
        return;
    }

    for (i = pos; i < count - 1; i++)
    {
        table[i] = table[i + 1];
    }

    count--;

    printf("Symbol deleted successfully.\n");
}

/* Function to display the symbol table */
void display()
{
    int i;

    if (count == 0)
    {
        printf("Symbol table is empty.\n");
        return;
    }

    printf("\n---------------------------------------------\n");
    printf("        SYMBOL TABLE\n");
    printf("---------------------------------------------\n");
    printf("%-15s %-15s %-15s\n",
           "Name", "Type", "Value");
    printf("---------------------------------------------\n");

    for (i = 0; i < count; i++)
    {
        printf("%-15s %-15s %-15s\n",
               table[i].name,
               table[i].type,
               table[i].value);
    }

    printf("---------------------------------------------\n");
}

int main()
{
    int choice;
    char name[50];
    int pos;

    while (1)
    {
        printf("\n===== SYMBOL TABLE =====\n");
        printf("1. Insert\n");
        printf("2. Search\n");
        printf("3. Delete\n");
        printf("4. Display\n");
        printf("5. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                insert();
                break;

            case 2:
                printf("Enter symbol name to search: ");
                scanf("%s", name);

                pos = search(name);

                if (pos != -1)
                {
                    printf("Symbol found!\n");
                    printf("Name  : %s\n", table[pos].name);
                    printf("Type  : %s\n", table[pos].type);
                    printf("Value : %s\n", table[pos].value);
                }
                else
                {
                    printf("Symbol not found!\n");
                }
                break;

            case 3:
                deleteSymbol();
                break;

            case 4:
                display();
                break;

            case 5:
                printf("Exiting program...\n");
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }

    return 0;
}
