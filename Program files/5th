#include <stdio.h>

int main()
{
    char ch;
    int whitespace = 0;
    int newline = 0;

    printf("Enter the text (press Ctrl+D on Linux/Mac or Ctrl+Z then Enter on Windows to finish):\n");

    while ((ch = getchar()) != EOF)
    {
        if (ch == ' ' || ch == '\t')
        {
            whitespace++;
        }
        else if (ch == '\n')
        {
            newline++;
        }
    }

    printf("\nNumber of whitespaces : %d\n", whitespace);
    printf("Number of newlines    : %d\n", newline);

    return 0;
}
