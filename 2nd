#include <stdio.h>
#include <string.h>

void checkComment(char *str) {
    int len = strlen(str);
    
    // Skip leading whitespaces
    int i = 0;
    while (i < len && (str[i] == ' ' || str[i] == '\t')) {
        i++;
    }

    // Check for Single-line comment: starts with //
    if (str[i] == '/' && str[i + 1] == '/') {
        printf("It is a Single-line Comment.\n");
    }
    // Check for Multi-line comment: starts with /* and ends with */
    else if (str[i] == '/' && str[i + 1] == '*') {
        int isClosed = 0;
        for (int j = i + 2; j < len - 1; j++) {
            if (str[j] == '*' && str[j + 1] == '/') {
                isClosed = 1;
                break;
            }
        }
        if (isClosed) {
            printf("It is a Multi-line Comment.\n");
        } else {
            printf("Unterminated Multi-line Comment!\n");
        }
    } 
    else {
        printf("It is NOT a Comment.\n");
    }
}

int main() {
    char line1[] = "// This is a single line comment";
    char line2[] = "/* This is a multi-line comment */";
    char line3[] = "int x = 10; // Inline comment";

    printf("Line 1: %s\nResult: ", line1);
    checkComment(line1);

    printf("\nLine 2: %s\nResult: ", line2);
    checkComment(line2);

    printf("\nLine 3: %s\nResult: ", line3);
    checkComment(line3);

    return 0;
}
